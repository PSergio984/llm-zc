# Kestra API Keys (all values must be base64-encoded with SECRET_ prefix)
# On Windows PowerShell:
#   $env:SECRET_GEMINI_API_KEY = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("your-gemini-key"))
#   $env:SECRET_OPENAI_API_KEY = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("your-openai-key"))
#   $env:SECRET_TAVILY_API_KEY = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("your-tavily-key"))
#   $env:GEMINI_API_KEY = "your-gemini-key"     # plain text (for Kestra AI config)
#
# Then run: docker compose up -d

SECRET_GEMINI_API_KEY=
SECRET_OPENAI_API_KEY=
SECRET_TAVILY_API_KEY=
GEMINI_API_KEY=
